# ~/.bash_common
# Universal interactive bash customizations. Sourced from ~/.bashrc.
# Safe to commit and share across machines. Anything machine-specific
# (CUDA paths, API tokens, hostnames) belongs in ~/.bash_secrets instead.

# ---------- bare-repo dotfiles alias ----------
# The `dotfiles` alias is defined in ~/.bashrc so it loads even in shells that
# do not source this file. Left here only as a usage reminder:
#   dotfiles status / dotfiles add <file> / dotfiles commit / dotfiles push

# ---------- clipboard ----------
# Clipboard copy is handled by the standalone `clip` script in ~/.local/bin:
# native pbcopy on macOS, wl-copy/xclip/xsel on Linux desktops, and OSC 52 over
# SSH/tmux otherwise. ~/.bashrc puts ~/.local/bin on PATH. Use `clip <file>` or
# `cmd | clip`. Keep `pbcopy` working in bash where there is no native one.
if ! command -v pbcopy >/dev/null 2>&1 && command -v clip >/dev/null 2>&1; then
    alias pbcopy='clip'
fi

# ---------- git helpers ----------
# Add tracked + commit in one step
gac() {
    if [ -z "$1" ]; then
        echo "Error: Please provide a commit message." >&2
        echo "Usage: gac \"your commit message\"" >&2
        return 1
    fi
    git commit -am "$1"
}

# Amend currently-tracked changes into HEAD without changing the message.
# Two spellings because muscle memory varies.
alias gaca='git commit -a --amend --no-edit'
alias gcaa='git commit -a --amend --no-edit'

# ---------- git-aware prompt (__git_ps1) ----------
# Source git-sh-prompt from common Debian/Ubuntu locations. Silent if missing.
if [ -f /usr/lib/git-core/git-sh-prompt ]; then
    . /usr/lib/git-core/git-sh-prompt
elif [ -f /etc/bash_completion.d/git-prompt ]; then
    . /etc/bash_completion.d/git-prompt
fi

export GIT_PS1_SHOWDIRTYSTATE=1
export GIT_PS1_SHOWUNTRACKEDFILES=1
export GIT_PS1_SHOWUPSTREAM="auto"

# ---------- host identity ----------
# Same scheme as .zsh_common: prompt host colour and OSC 12 cursor colour keyed
# by hostname; bright red for any host not listed here.
case ${HOSTNAME%%.*} in
    magpu)      _host_colour='01;35'; _host_cursor='#d75fff' ;;
    miniserver) _host_colour='01;36'; _host_cursor='#5fd7ff' ;;
    *)          _host_colour='01;91'; _host_cursor='#ff5f5f' ;;
esac
_set_host_cursor() { printf '\033]12;%s\007' "$_host_cursor"; }

# iTerm2 tab: short hostname in the host colour, as in .zsh_common.
_host_tab_seq=$(~/.local/bin/term-tab "${HOSTNAME%%.*}" "$_host_cursor" 2>/dev/null)
if [ -n "$TMUX" ]; then
    _host_tab_seq=$'\ePtmux;'${_host_tab_seq//$'\e'/$'\e\e'}$'\e\\'
    tmux set -gq @host_tab "$_host_cursor"
fi
_set_host_tab() { printf '%s' "$_host_tab_seq"; }
PROMPT_COMMAND="_set_host_cursor;_set_host_tab${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

# Compressed prompt: host in its colour + green CWD basename + cyan git status.
# Example: magpu my_project|main*+ $
if type __git_ps1 >/dev/null 2>&1; then
    export PS1='\[\033['"$_host_colour"'m\]\h\[\033[00m\] \[\033[01;32m\]\W\[\033[01;36m\]$(__git_ps1 "|%s")\[\033[00m\]\$ '
fi

# ---------- per-machine overrides ----------
# .bash_secrets is intentionally untracked; use it for tokens, CUDA paths, etc.
[ -f ~/.bash_secrets ] && . ~/.bash_secrets

# ---------- ble.sh (must be sourced LAST to wrap readline) ----------
[ -f ~/ble.sh/out/ble.sh ] && . ~/ble.sh/out/ble.sh
