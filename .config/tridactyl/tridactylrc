" ~/.config/tridactyl/tridactylrc  (load with :source; export with :mktridactylrc --clipboard)

" tabs
bind J tabnext
bind K tabprev
bind '' tab #
unbind d
bind x tabclose
bind X undo
unbind u

" containers: ,t new tab in a container, ,r move this tab to one; names fuzzy match
set tabopencontaineraware true
command ctab tabopen -c
command rc recontain
command ctabs tabsort --containers
bind ,t fillcmdline ctab
bind ,r fillcmdline rc

" scrolling (revert with :nosmoothscrollwizard)
smoothscrollwizard

" external editor: Ctrl+I in any text box opens Neovide (absolute paths required).
" TRIDACTYL_EDITOR tells init.vim to make the window translucent.
set editorcmd TRIDACTYL_EDITOR=1 /opt/homebrew/bin/neovide --no-fork --neovim-bin /opt/homebrew/bin/nvim %f

" blacklist current site with ,b; takes effect on next load, so press r after
bind ,b composite js document.location.hostname | blacklistadd

blacklistadd mail.google.com
blacklistadd overleaf.com

" tab switching still available on blacklisted sites
bind --mode=ignore <C-b> fillcmdline taball
bind --mode=ignore <C-'> tab #

" optional, will revert if buggy
bind / fillcmdline find
bind ? fillcmdline find --reverse
bind n findnext --search-from-view
bind N findnext --search-from-view --reverse
bind ,<Space> nohlsearch
