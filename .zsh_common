# ~/.zsh_common
# Universal interactive zsh customizations. Sourced from the dotfiles-managed
# block at the end of ~/.zshrc. Safe to commit and share across machines.
# Anything machine-specific (conda, JDK, project paths, tokens) belongs in
# ~/.zshrc or ~/.zsh_secrets instead.

# ---------- listing ----------
alias ll='ls -la'
alias l='ls -l'
alias la='ls -a'

# ---------- clipboard ----------
# `clip` (in ~/.local/bin) is native pbcopy on macOS, wl-copy/xclip on Linux
# desktops, and OSC 52 over SSH/tmux. Keep `pbcopy` spelled the same everywhere.
if ! command -v pbcopy >/dev/null 2>&1 && command -v clip >/dev/null 2>&1; then
    alias pbcopy='clip'
fi

# ---------- editor ----------
# nvim is the default editor (~/.config/nvim/init.vim); ~/.vimrc still drives
# plain vim, which stays installed as the fallback on machines without nvim.
if command -v nvim >/dev/null 2>&1; then
    export EDITOR='nvim'
    export VISUAL='nvim'
    alias vim='nvim'
elif command -v vim >/dev/null 2>&1; then
    export EDITOR='vim'
    export VISUAL='vim'
fi

# ---------- git helpers ----------
gac() {
    if [ -z "$1" ]; then
        echo "Error: Please provide a commit message." >&2
        echo "Usage: gac \"your commit message\"" >&2
        return 1
    fi
    git commit -am "$1"
}

alias gaca='git commit -a --amend --no-edit'
alias gcaa='git commit -a --amend --no-edit'

# ---------- prompt ----------
autoload -Uz promptinit && promptinit
(( ${+functions[prompt_pure_setup]} )) && prompt pure

# ---------- line editor ----------
_zsh_src() {
    local f
    for f in "$@"; do
        [ -r "$f" ] && source "$f" && return 0
    done
    return 1
}

(( ${+_comps} )) || { autoload -Uz compinit && compinit; }

# Order is fixed by upstream: fzf-tab must bind its widgets before the
# highlighter and autosuggestions wrap them, and autosuggestions must come after
# the highlighter.
_zsh_src /opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh \
         /usr/local/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh \
         "$HOME/.zsh/fzf-tab/fzf-tab.zsh"

_zsh_src /opt/homebrew/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh \
         /usr/local/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh \
         /usr/share/zsh/plugins/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

_zsh_src /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
         /usr/local/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
         /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

unset -f _zsh_src

# ---------- per-machine overrides ----------
[ -f "$HOME/.zsh_secrets" ] && source "$HOME/.zsh_secrets"

# Keep $? clean so pure does not paint the first prompt red.
true
