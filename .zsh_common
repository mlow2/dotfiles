# ~/.zsh_common
# Universal interactive zsh customizations. Sourced from the dotfiles-managed
# block at the end of ~/.zshrc. Safe to commit and share across machines.
# Anything machine-specific (conda, JDK, project paths, tokens) belongs in
# ~/.zshrc or ~/.zsh_secrets instead.

# ---------- listing ----------
alias ll='ls -la'
alias l='ls -l'
alias la='ls -a'

# ---------- clipboard ----------
# `clip` (in ~/.local/bin) is native pbcopy on macOS, wl-copy/xclip on Linux
# desktops, and OSC 52 over SSH/tmux. Keep `pbcopy` spelled the same everywhere.
if ! command -v pbcopy >/dev/null 2>&1 && command -v clip >/dev/null 2>&1; then
    alias pbcopy='clip'
fi

# ---------- git helpers ----------
gac() {
    if [ -z "$1" ]; then
        echo "Error: Please provide a commit message." >&2
        echo "Usage: gac \"your commit message\"" >&2
        return 1
    fi
    git commit -am "$1"
}

alias gaca='git commit -a --amend --no-edit'
alias gcaa='git commit -a --amend --no-edit'

# Clone into ~/repos/<account>/<repo> using the key that account's gitconfig
# names. Needed because includeIf gitdir: rules cannot apply during the clone
# itself; afterwards the directory governs identity and key.
gclone() {
    local acct="$1" url="$2"
    if [ -z "$acct" ] || [ -z "$url" ]; then
        echo "Usage: gclone <account> <clone-url>" >&2
        return 1
    fi

    local cfg="$HOME/.config/git/$acct.gitconfig"
    if [ ! -f "$cfg" ]; then
        echo "gclone: no config for account '$acct' ($cfg)" >&2
        return 1
    fi

    local sshcmd dest
    sshcmd=$(git config -f "$cfg" core.sshCommand 2>/dev/null)
    dest="$HOME/repos/$acct/${${url##*/}%.git}"

    GIT_SSH_COMMAND="${sshcmd:-ssh}" git clone "$url" "$dest" || return
    cd "$dest"
}

# ---------- prompt and highlighting ----------
autoload -Uz promptinit && promptinit
(( ${+functions[prompt_pure_setup]} )) && prompt pure

# Must be sourced last to wrap the line editor.
for _zsh_hl in \
    /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
    /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
do
    [ -r "$_zsh_hl" ] && source "$_zsh_hl" && break
done
unset _zsh_hl

# ---------- per-machine overrides ----------
[ -f "$HOME/.zsh_secrets" ] && source "$HOME/.zsh_secrets"
